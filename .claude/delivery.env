# Delivery configuration for this repository, sourced by /worktree-new, /gate, /sqmerge and ~/.claude/scripts/gate-run.
# Empty JIRA_KEY: ticketless; changes use a kebab-case slug.
JIRA_KEY=
# The plugin's skill metadata checks and the pr-shepherd and backlog-triage helper tests. The cache provider is off so a
# run leaves no .pytest_cache behind to dirty the work tree.
GATE_FULL='python3 -m pytest -q -p no:cacheprovider plugins/rjw-sdlc/tests plugins/rjw-sdlc/skills/pr-shepherd/tests plugins/rjw-sdlc/skills/backlog-triage/tests'
# The suites are small, so a scoped gate runs them all.
GATE_SCOPED="$GATE_FULL"
# The suites are small and IO-bound; arm-run's help asks gates to use the latency class.
GATE_ARM='--cpu-light --class latency -m 2G'
# Nothing installs from the work tree: the plugin installs from GitHub (INSTALL_BY_USER).
INSTALL=''
# The installed plugin comes from this fork's GitHub main, so a merge is live only after these run (then restart).
INSTALL_BY_USER='claude plugin marketplace update rjw-skills && claude plugin update rjw-sdlc@rjw-skills'
